{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jenkins: 准备 JDK",
      "type": "process",
      "command": "pwsh.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/.vscode/prepare-jdk.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Jenkins: 安装前端依赖",
      "type": "shell",
      "command": "yarn.cmd",
      "args": ["install", "--immutable"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Jenkins: 构建前端",
      "type": "shell",
      "command": "yarn.cmd",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Jenkins: 安装前端依赖",
      "problemMatcher": []
    },
    {
      "label": "Jenkins: 构建 WAR",
      "type": "process",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile", "-File", "${workspaceFolder}/.vscode/run-maven.ps1",
        "-MavenExecutable", "${config:maven.executable.path}",
        "-am", "-pl", "war,bom", "-Pquick-build",
        "-Dskip.frontend=true",
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MAVEN_ARGS": "-s \"${config:java.configuration.maven.userSettings}\""
        }
      },
      "dependsOn": ["Jenkins: 准备 JDK", "Jenkins: 构建前端"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
