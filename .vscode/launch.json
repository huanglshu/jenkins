{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jenkins: 运行 / 调试",
      "type": "java",
      "request": "launch",
      "mainClass": "executable.Main",
      "javaExec": "${workspaceFolder}/.vscode/target/jenkins-jdk/bin/java.exe",
      "classPaths": ["${workspaceFolder}/war/target/jenkins.war"],
      "sourcePaths": [
        "${workspaceFolder}/war/src/main/java",
        "${workspaceFolder}/core/src/main/java"
      ],
      "args": ["--prefix=/jenkins"],
      "env": {
        "JENKINS_HOME": "${workspaceFolder}/war/work"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "preLaunchTask": "Jenkins: 构建 WAR"
    },
    {
      "name": "Jenkins: 直接运行（跳过构建）",
      "type": "java",
      "request": "launch",
      "mainClass": "executable.Main",
      "javaExec": "${workspaceFolder}/.vscode/target/jenkins-jdk/bin/java.exe",
      "classPaths": ["${workspaceFolder}/war/target/jenkins.war"],
      "sourcePaths": [
        "${workspaceFolder}/war/src/main/java",
        "${workspaceFolder}/core/src/main/java"
      ],
      "args": ["--prefix=/jenkins"],
      "env": {
        "JENKINS_HOME": "${workspaceFolder}/war/work"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "preLaunchTask": "Jenkins: 准备 JDK"
    }
  ]
}
// PowerShell 示例：先完成前端构建，再执行 Maven。
// $env:JAVA_HOME = "E:/Java/win_jdk/corretto-21.0.5"
// mvn.cmd -s "E:/Java/maven/maven-setting/alphax-test-settings.xml" -am -pl "war,bom" -Pquick-build '-Dskip.frontend=true' install
